          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"authors_json\" TEXT NOT NULL DEFAULT '[]', \"description\" TEXT NULL, \"language\" TEXT NULL, \"identifier\" TEXT NULL, \"publisher\" TEXT NULL, \"published_at\" TEXT NULL, \"format\" TEXT NOT NULL, \"file_path\" TEXT NOT NULL UNIQUE, \"cover_path\" TEXT NULL, \"file_size_bytes\" INTEGER NOT NULL, \"file_checksum\" TEXT NOT NULL, \"reading_status\" TEXT NOT NULL DEFAULT 'unread', \"added_at\" INTEGER NOT NULL, \"last_opened_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, \"metadata_json\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(title)) > 0), CHECK (format IN ('epub', 'pdf')), CHECK (reading_status IN ('unread', 'reading', 'finished')), CHECK (file_size_bytes > 0), CHECK (length(file_checksum) = 64 AND file_checksum NOT GLOB '*[^0-9a-f]*'), CHECK (json_valid(authors_json) AND json_type(authors_json) = 'array'), CHECK (file_path <> '' AND substr(file_path, 1, 1) <> '/' AND instr(file_path, char(92)) = 0 AND '/' || file_path || '/' NOT LIKE '%/../%' AND '/' || file_path || '/' NOT LIKE '%/./%'), CHECK (cover_path IS NULL OR (cover_path <> '' AND substr(cover_path, 1, 1) <> '/' AND instr(cover_path, char(92)) = 0 AND '/' || cover_path || '/' NOT LIKE '%/../%' AND '/' || cover_path || '/' NOT LIKE '%/./%')));"
        }
